rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /progress/{lessonId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /feedback/{feedbackId} {
        allow create: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['message', 'createdAt'])
          && request.resource.data.message is string
          && request.resource.data.message.size() >= 5
          && request.resource.data.message.size() <= 2000;
        allow read, update, delete: if request.auth != null
          && request.auth.uid == userId;
      }

      match /practiceSessions/{sessionId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly([
            'durationSeconds',
            'category',
            'targetLabel',
            'predictionLabel',
            'confidence',
            'outcome',
            'createdAt'
          ])
          && request.resource.data.durationSeconds is int
          && request.resource.data.durationSeconds > 0
          && request.resource.data.category in ['alphabet', 'digit', 'vocabulary']
          && request.resource.data.targetLabel is string
          && request.resource.data.predictionLabel is string
          && request.resource.data.confidence is number
          && request.resource.data.confidence >= 0
          && request.resource.data.confidence <= 1
          && request.resource.data.outcome == 'correct';
        allow update: if false;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      match /practicePredictions/{predictionId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly([
            'category',
            'targetLabel',
            'predictionLabel',
            'confidence',
            'stableMilliseconds',
            'matchedTarget',
            'createdAt'
          ])
          && request.resource.data.category in ['alphabet', 'digit', 'vocabulary']
          && request.resource.data.targetLabel is string
          && request.resource.data.predictionLabel is string
          && request.resource.data.confidence is number
          && request.resource.data.confidence >= 0
          && request.resource.data.confidence <= 1
          && request.resource.data.stableMilliseconds is int
          && request.resource.data.stableMilliseconds >= 0
          && request.resource.data.matchedTarget is bool;
        allow update: if false;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
